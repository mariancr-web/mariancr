{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/:curso/:tema/libro", "destination": "/libro.html" },
    { "source": "/:curso/:tema", "destination": "/tema.html" }
  ],
  "headers": [
    { "source": "/datos/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/temas/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
